@model IEnumerable<MyTechnicalBlog.Models.User>

<div class="container mt-4">
    <h2>Все пользователи</h2>
    <table class="table table-striped table-bordered mt-3">
        <thead class="thead-dark">
            <tr>
                <th>ID</th>
                <th>Username</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var user in Model)
                {
                    <tr>
                        <td>@user.Id</td>
                        <td>@user.Username</td>
                        <td>
                            <form asp-action="Delete" asp-route-id="@user.Id" method="post" style="display:inline;">
                                <button type="submit" class="btn btn-danger btn-sm">Удалить</button>
                            </form>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center text-muted">Пользователей пока нет. Зарегистрируйте первого!</td>
                </tr>
            }
        </tbody>
    </table>
</div>