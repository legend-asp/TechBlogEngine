@model MyTechnicalBlog.Models.User
@{
    ViewData["Title"] = "Вход";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-4 card shadow p-4">
            <h2 class="text-center mb-4">Вход</h2>

            <form asp-action="Login" method="post">
                <div class="form-group mb-3">
                    <label asp-for="Username" class="form-label">Имя пользователя</label>
                    <input asp-for="Username" class="form-control" />
                    <span asp-validation-for="Username" class="text-danger small"></span>
                </div>

                <div asp-validation-summary="All" class="text-danger small"></div>

                <button type="submit" class="btn btn-primary w-100 mb-3">Войти</button>
            </form>

            <div class="text-center mt-3">
                <span>Нет аккаунта?</span>
                <a href="/Account/Register" class="btn btn-link p-0" style="vertical-align: baseline;">Зарегистрироваться</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}