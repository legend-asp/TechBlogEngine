<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MyBlog</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    <style>
        body {
            padding-top: 70px;
        }

        .navbar {
            background-color: #343a40 !important;
        }

        .nav-link.admin-link {
            color: #ffc107 !important;
            font-weight: bold;
        }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark fixed-top shadow">
        <div class="container">
            <a class="navbar-brand" href="/">MY_TECHNICAL_BLOG</a>
            <button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#mainNavbar">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav mr-auto">
                    <li class="nav-item"><a class="nav-link" href="/Articles">Статьи</a></li>
                    <li class="nav-item"><a class="nav-link" href="/Tags">Теги</a></li>

                    @if (User.Identity.IsAuthenticated && User.IsInRole("Администратор"))
                    {
                        <li class="nav-item"><a class="nav-link admin-link" href="/Users">Пользователи</a></li>
                        <li class="nav-item"><a class="nav-link admin-link" href="/Roles">Роли</a></li>
                        <li class="nav-item"><a class="nav-link admin-link" href="/Comments">Модерация</a></li>
                    }
                </ul>

                <div class="navbar-nav ml-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <span class="navbar-text mr-3 text-light">
                            Привет, <strong>@User.Identity.Name</strong>!
                        </span>
                        <form asp-controller="Account" asp-action="Logout" method="post" class="form-inline">
                            <button type="submit" class="btn btn-outline-danger btn-sm">Выйти</button>
                        </form>
                    }
                    else
                    {
                        <a href="/Account/Login" class="btn btn-outline-light btn-sm mr-2">Войти</a>
                        <a href="/Account/Register" class="btn btn-primary btn-sm">Регистрация</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="footer text-center mt-5 py-3 border-top bg-light">
        <div class="container text-muted">
            <span>&copy; 2026 - MyTechnicalBlog</span>
        </div>
    </footer>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.min.js"></script>

    @* ЭТОТ БЛОК ОБЯЗАТЕЛЕН ДЛЯ ВАЛИДАЦИИ *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>